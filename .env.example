# 复制为 .env 并填入真实值：cp .env.example .env
#
# 生成强随机值：
#   .venv/bin/python -c "import secrets; print(secrets.token_urlsafe(48))"   # 密钥
#   .venv/bin/python -c "import secrets; print('Tk-' + secrets.token_urlsafe(12))"  # 密码
#
# 启动会做安全自检（app/startup_checks.py）：仍在用出厂弱默认值会打印告警；
# 设置 TK_STRICT_SECURITY=1 则直接拒绝启动。

# ── 访问令牌密钥 ──
# 不填也能跑：程序会自动生成一份随机密钥并写入 .jwt_secret（0600，已 gitignore）。
# 但多实例部署必须显式共享同一个值，否则各实例签发的令牌互不认可。
TK_JWT_SECRET=change-me
TK_TOKEN_TTL_MINUTES=720

# ── 管理员凭据 ──
# TK_ADMIN_PASSWORD 只在"数据库里还没有 admin"时用于初始化。
# 若库里 admin 仍是出厂默认密码，而这里配了别的值，启动时会自动替换掉它。
TK_MASTER_PIN=change-me
TK_ADMIN_USER=admin
TK_ADMIN_PASSWORD=change-me

# ── 前端来源白名单 ──
TK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TK_PUBLIC_BASE_URL=http://localhost:8000

# ── 安全严格模式 ──
# 1 = 检测到弱默认凭据就拒绝启动（公网部署建议开启）
TK_STRICT_SECURITY=

# ── 登录防爆破限流（默认：5 次 / 5 分钟窗口 → 锁定 15 分钟）──
TK_LOGIN_MAX_ATTEMPTS=5
TK_LOGIN_WINDOW_SECONDS=300
TK_LOGIN_LOCKOUT_SECONDS=900

# ── 反向代理 ──
# 部署在 Nginx 等代理后面时设为 1，限流才会按 X-Forwarded-For 取真实客户端 IP。
# ⚠️ 直连暴露时必须保持为空，否则攻击者可伪造该头绕过限流。
TK_TRUST_PROXY=
